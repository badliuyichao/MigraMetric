<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.migrametric.mapper.module.ModuleMapper">

    <!-- 基础结果映射 -->
    <resultMap id="BaseResultMap" type="com.migrametric.entity.module.Module">
        <id column="id" property="id"/>
        <result column="module_name" property="moduleName"/>
        <result column="system_id" property="systemId"/>
        <result column="category" property="category"/>
        <result column="base_workload" property="baseWorkload"/>
        <result column="default_weight" property="defaultWeight"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
    </resultMap>

    <!-- 根据模块名称统计数量（排除指定ID） -->
    <select id="countByModuleNameExcludeId" resultType="int">
        SELECT COUNT(*)
        FROM sys_module
        WHERE module_name = #{moduleName}
        <if test="excludeId != null">
            AND id != #{excludeId}
        </if>
    </select>

    <!-- 根据项目ID统计模块引用数量 -->
    <select id="countByProjectReference" resultType="int">
        SELECT COUNT(*)
        FROM proj_module_config
        WHERE module_id = #{moduleId}
    </select>

</mapper>
