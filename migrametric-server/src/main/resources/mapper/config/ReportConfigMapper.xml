<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.migrametric.mapper.config.ReportConfigMapper">

    <!-- 基础结果映射 -->
    <resultMap id="BaseResultMap" type="com.migrametric.entity.config.ReportConfig">
        <id column="id" property="id"/>
        <result column="config_key" property="configKey"/>
        <result column="config_value" property="configValue"/>
        <result column="config_name" property="configName"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
    </resultMap>

    <!-- 根据配置键查询 -->
    <select id="selectByConfigKey" resultMap="BaseResultMap">
        SELECT * FROM sys_report_config WHERE config_key = #{configKey}
    </select>

</mapper>
